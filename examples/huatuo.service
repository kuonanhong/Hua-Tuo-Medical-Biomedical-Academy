# systemd 服務範例：sudo cp examples/huatuo.service /etc/systemd/system/huatuo.service
# sudo systemctl daemon-reload && sudo systemctl enable --now huatuo
[Unit]
Description=Hua Tuo Medical & Biomedical Academy server
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/srv/huatuo
EnvironmentFile=/srv/huatuo/.env
ExecStart=/usr/bin/python3 /srv/huatuo/portable/server.py --host 127.0.0.1 --port 8020
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
