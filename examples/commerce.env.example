# 複製為 .env（放在專案根目錄，絕不放進 public/）。只填需要的項目；留空代表停用該功能。
# ---------------------------------------------------------------- 站點
SITE_NAME=華佗醫藥生醫學院 Hua Tuo Medical Academy
# 公開部署時必填（HTTPS、反向代理之後）；本機測試留空會用 http://127.0.0.1:8020
SITE_ORIGIN=
HT_HOST=127.0.0.1
HT_PORT=8020
# ---------------------------------------------------------------- 註冊驗證（信箱 + 手機）
# VERIFY_MODE=auto：有 SMTP+SMS → full；只有 SMTP → email（兩組驗證碼都寄到信箱）；都沒有且在本機 → dev（驗證碼直接顯示）
VERIFY_MODE=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=華佗醫藥生醫學院
# SMS：twilio / mitake（三竹）/ webhook（自家簡訊閘道，POST JSON {to,text}）
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MITAKE_USERNAME=
MITAKE_PASSWORD=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# ---------------------------------------------------------------- 收費（每門課第一節免費，其餘由通行證解鎖）
# disabled = 全部開放（站長／展示版）；transfer = 只收郵局轉帳；sandbox = 測試金流；live = 正式收費
BILLING_MODE=transfer
# 撥款／收款帳戶（金流商後台也要登記同一帳戶）
PAYOUT_BANK_NAME=中華郵政（郵局）/ Chunghwa Post
PAYOUT_BANK_CODE=700
PAYOUT_BRANCH_NO=0101034
PAYOUT_ACCOUNT_NO=0187821
PAYOUT_ACCOUNT_NAME=
# Stripe（國際信用卡、3-D Secure）。Webhook 端點：$SITE_ORIGIN/api/billing/stripe/webhook，事件 checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_3DS=any
# 綠界 ECPay（台灣信用卡）。ReturnURL：$SITE_ORIGIN/api/billing/ecpay/notify
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# 正式收費前必須明確確認（HTTPS、條款、退款流程、真實小額測試完成）
BILLING_LIVE_CONFIRMED=0
COMMERCE_LEGAL_READY=0
# 匯率：預設每 12 小時向 open.er-api.com 更新；離線請設 RATES_OFFLINE=1
RATES_OFFLINE=0
# ---------------------------------------------------------------- AI 師傅（任選一或多條路線）
# 本機 llama.cpp（run-ai-llamacpp.sh 會自動設定）或任何 OpenAI 相容服務
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_LABEL=
# 本機 Ollama（run-ai-ollama.sh 會自動設定）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=
# 雲端
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=120
AI_HOURLY_LIMIT=60
# 本地教材索引（index-documents.sh 產生）
KNOWLEDGE_INDEX=portable/data/knowledge.json
# 預設只有持通行證的會員能檢索本地教材；設 1 讓所有登入者都能檢索
DOCUMENTS_FOR_ALL=0
# 除錯
HT_LOG_REQUESTS=0
HT_DEBUG=0
